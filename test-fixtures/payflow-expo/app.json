{
  "expo": {
    "name": "PayFlow",
    "slug": "payflow",
    "scheme": "payflow",
    "android": {
      "package": "com.payflow.app",
      "permissions": ["READ_CONTACTS", "ACCESS_BACKGROUND_LOCATION", "CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "com.payflow.app",
      "infoPlist": { "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true } }
    }
  }
}
